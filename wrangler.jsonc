{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "streetwear-perfume-commerce",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "streetwear-perfume-commerce-db",
      "database_id": "aec7e134-d2d7-4c1d-9912-49577b439d45"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "streetwear-perfume-commerce-media"
    }
  ],
  "vars": {
    "SHOPIFY_STORE_DOMAIN": "78701p-u5.myshopify.com",
    "SHOPIFY_STOREFRONT_API_VERSION": "2026-07"
  }
}
