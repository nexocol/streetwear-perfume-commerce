{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "streetwear-perfume-commerce",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "streetwear-perfume-commerce-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "streetwear-perfume-commerce-media"
    }
  ]
}
